# Base de datos PostgreSQL (Neon/Supabase/etc)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Groq API Key - Obtener en https://console.groq.com/keys
GROQ_API_KEY=tu_api_key_aqui

# Vercel Blob Storage (para uploads de archivos)
BLOB_READ_WRITE_TOKEN=tu_blob_token_aqui

# Google AI (para resúmenes de material)
GOOGLE_AI_API_KEY=tu_google_ai_key_aqui

# Session secret (cualquier string aleatorio largo)
SESSION_SECRET=cambiar-por-un-string-aleatorio-de-al-menos-32-caracteres
