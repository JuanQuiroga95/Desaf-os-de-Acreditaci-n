// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum MaterialType {
  THEORY
  VIDEO
  EXERCISE
  PROMPT
  RUBRIC
  TP_TEMPLATE
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  password    String
  name        String
  role        Role         @default(STUDENT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  subjects          Subject[]    @relation("TeacherSubjects")
  progress          Progress[]
  enrollments       Enrollment[]
  studentEncounters Encounter[]  @relation("StudentEncounters")
  teacherEncounters Encounter[]  @relation("TeacherEncounters")
}

model Subject {
  id          String       @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  teacherId   String
  teacher     User         @relation("TeacherSubjects", fields: [teacherId], references: [id])
  challenges  Challenge[]
  materials   Material[]
  enrollments Enrollment[]
  encounters  Encounter[]
  examDates   ExamDate[]
}

enum ChallengeType {
  REGULAR
  DIAGNOSTICO
  AUTOEVALUACION
}

model Challenge {
  id          String        @id @default(cuid())
  title       String
  objective   String?
  content     Json?
  type        ChallengeType @default(REGULAR)
  fileUrl     String?       // URL del PDF original si fue convertido
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  subjectId   String
  subject     Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  progress    Progress[]
  materials   Material[]
}

model Progress {
  id          String    @id @default(cuid())
  status      String    @default("PENDING")
  score       Float?
  feedback    String?
  answers     Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
}

model Material {
  id          String       @id @default(cuid())
  type        MaterialType
  title       String
  content     String
  level       String?      // BASICO | INTERMEDIO | AVANZADO (para EXERCISE)
  fileUrl     String?      // URL de Vercel Blob para archivos subidos
  order       Int          @default(0)
  visible     Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  subjectId   String
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  challengeId String?
  challenge   Challenge?   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  studentId String
  student   User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId])
}

model Encounter {
  id        String   @id @default(cuid())
  date      DateTime
  notes     String?
  status    String   @default("PENDING")
  type      String   @default("VIRTUAL")
  createdAt DateTime @default(now())

  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("StudentEncounters", fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User     @relation("TeacherEncounters", fields: [teacherId], references: [id], onDelete: Cascade)
}

model ExamDate {
  id        String   @id @default(cuid())
  date      DateTime
  time      String?
  room      String?
  notes     String?
  createdAt DateTime @default(now())

  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}
